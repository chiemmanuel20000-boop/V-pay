        // Telco Data Packages
        const DATA_PLANS = {
            MTN: [
                { id: "m1", label: "MTN 1GB Daily - ₦300", price: 300 },
                { id: "m2", label: "MTN 2.5GB 2-Days - ₦500", price: 500 },
                { id: "m3", label: "MTN 10GB Monthly - ₦3,000", price: 3000 },
