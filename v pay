            GLO: [
                { id: "g1", label: "Glo 1.25GB 1-Day - ₦200", price: 200 },
                { id: "g2", label: "Glo 3GB 2-Days - ₦500", price: 500 },
                { id: "g3", label: "Glo 10.8GB Monthly - ₦3,000", price: 3000 }
            ],
            VITAL: [
                { id: "v1", label: "Vital 2GB 3-Days - ₦400", price: 400 },
                { id: "v2", label: "Vital 8GB Monthly - ₦2,500", price: 2500 }
            ]
        };

        // TV Packages
        const TV_PACKAGES = {
            GOTV: [
                { label: "GOtv Smallie - ₦1,300/mo", price: 1300 },
                { label: "GOtv Jinja - ₦2,700/mo", price: 2700 },
                { label: "GOtv Jolli - ₦3,950/mo", price: 3950 },
                { label: "GOtv Max - ₦5,700/mo", price: 5700 },
                { label: "GOtv Supa - ₦7,600/mo", price: 7600 }
            ],
            DSTV: [
                { label: "DStv Yanga - ₦4,200/mo", price: 4200 },
                { label: "DStv Confam - ₦7,400/mo", price: 7400 },
                { label: "DStv Compact - ₦12,500/mo", price: 12500 },
                { label: "DStv Compact Plus - ₦19,800/mo", price: 19800 },
                { label: "DStv Premium - ₦29,500/mo", price: 29500 }
            ]
        };

        // Application Global State
        let currentUser = null;
        let selectedIdType = "NIN";
        let faceVerified = false;
        let selectedNetwork = "MTN";
        let selectedTvProvider = "GOTV";
        let isBalanceHidden = false;
        let activeUtilityTab = "airtime";

        // Pending Transaction Details for PIN Authorization
        let pendingTx = null;

        // Initialize App on Window Load
        window.onload = function() {
            setTimeout(() => {
                const preloader = document.getElementById('preloader');
                preloader.classList.add('opacity-0');
                setTimeout(() => preloader.style.display = 'none', 500);
            }, 1000);

            populateBanks();
            populateDataPlans();
            populateTvPackages();
            loadUserData();
        };

        // Dark/Light Theme Switching
        function toggleTheme() {
            document.documentElement.classList.toggle('dark');
        }

        // Show Specific View Screen
        function showScreen(screenId) {
            const screens = ['onboardingFlow', 'loginScreen', 'dashboardHub', 'transferScreen', 'airtimeDataScreen', 'tvCableScreen', 'txHistoryScreen'];
            screens.forEach(s => {
                const el = document.getElementById(s);
                if (el) el.classList.add('hidden');
            });

            document.getElementById(screenId).classList.remove('hidden');

            const nav = document.getElementById('bottomNav');
            if (['dashboardHub', 'transferScreen', 'airtimeDataScreen', 'tvCableScreen', 'txHistoryScreen'].includes(screenId)) {
                nav.classList.remove('hidden');
            } else {
                nav.classList.add('hidden');
            }
        }

        // Display Toast Feedback
        function showToast(message, isError = false) {
            const toast = document.getElementById('toastNotification');
            const msg = document.getElementById('toastMsg');
            const icon = document.getElementById('toastIcon');

            msg.innerText = message;
            if (isError) {
                icon.className = "fa-solid fa-circle-exclamation text-red-500";
            } else {
                icon.className = "fa-solid fa-circle-check text-brand-400";
            }

            toast.classList.remove('opacity-0', 'pointer-events-none');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 3000);
        }

        // Step 1: Phone OTP Simulation
        function triggerPhoneOTP() {
            const phone = document.getElementById('regPhone').value.trim();
            if (phone.length < 10) {
                showToast("Please enter a valid phone number", true);
                return;
            }

            const simulatedOTP = Math.floor(100000 + Math.random() * 900000);
            showToast(`VIPY Security Code: ${simulatedOTP}`);

            setTimeout(() => {
                document.getElementById('obStep1').classList.add('hidden');
                document.getElementById('obStep2').classList.remove('hidden');
                document.getElementById('stepDot2').classList.add('bg-brand-400');
            }, 1200);
        }

        // Select ID Type (NIN or BVN)
        function selectIdType(type) {
            selectedIdType = type;
            const tabNIN = document.getElementById('idTabNIN');
            const tabBVN = document.getElementById('idTabBVN');
            const label = document.getElementById('idNumberLabel');

            if (type === 'NIN') {
                tabNIN.className = "py-2.5 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm";
                tabBVN.className = "py-2.5 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400";
                label.innerText = "Enter National Identity Number (NIN)";
            } else {
                tabBVN.className = "py-2.5 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm";
                tabNIN.className = "py-2.5 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400";
                label.innerText = "Enter Bank Verification Number (BVN)";
            }
        }

        // Step 2: Validate NIN/BVN
        function verifyIdentity() {
            const idVal = document.getElementById('idNumberInput').value.trim();
            if (idVal.length !== 11 || isNaN(idVal)) {
                showToast(`Please enter a valid 11-digit ${selectedIdType}`, true);
                return;
            }

            showToast(`${selectedIdType} Verified Successfully!`);
            document.getElementById('obStep2').classList.add('hidden');
            document.getElementById('obStep3').classList.remove('hidden');
            document.getElementById('stepDot3').classList.add('bg-brand-400');
        }

        // Step 3: Simulated Facial Scan
        function simulatedFaceScan() {
            const line = document.getElementById('faceScannerLine');
            const btn = document.getElementById('startScanBtn');
            const check = document.getElementById('faceCheckMark');

            line.classList.remove('hidden');
            btn.innerText = "Scanning...";

            setTimeout(() => {
                line.classList.add('hidden');
                check.classList.remove('hidden');
                btn.innerText = "Face Verified";
                btn.classList.add('bg-brand-400/20', 'text-brand-500');
                faceVerified = true;
                showToast("Face Biometrics Captured");
            }, 2500);
        }

        function submitProfileAndFace() {
            const name = document.getElementById('regFullName').value.trim();
            if (!name) {
                showToast("Please enter your full legal name", true);
                return;
            }
            if (!faceVerified) {
                showToast("Please scan your face to proceed", true);
                return;
            }

            document.getElementById('obStep3').classList.add('hidden');
            document.getElementById('obStep4').classList.remove('hidden');
            document.getElementById('stepDot4').classList.add('bg-brand-400');
        }

        // Step 4: Security Credentials & Generate Account
        function finalizeRegistration() {
            const loginPin = document.getElementById('createLoginPin').value.trim();
            const txPin = document.getElementById('createTxPin').value.trim();
            const fullName = document.getElementById('regFullName').value.trim();
            const phone = document.getElementById('regPhone').value.trim();

            if (loginPin.length !== 6 || isNaN(loginPin)) {
                showToast("Login PIN must be exactly 6 digits", true);
                return;
            }

            if (txPin.length !== 4 || isNaN(txPin)) {
                showToast("Transaction PIN must be exactly 4 digits", true);
                return;
            }

            // Generate realistic 10-digit account number starting with 7 or 8
            const generatedAccNo = "70" + Math.floor(10000000 + Math.random() * 90000000);

            currentUser = {
                fullName: fullName,
                phone: phone,
                accountNumber: generatedAccNo,
                loginPin: loginPin,
                txPin: txPin,
                balance: 5000.00,
                history: [
                    {
                        type: 'Welcome Bonus',
                        title: 'Account Opening Bonus',
                        amount: 5000.00,
                        isCredit: true,
                        date: new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                        ref: 'VIPY-WELCOME-' + Math.floor(1000 + Math.random() * 9000)
                    }
                ]
            };

            saveUserData();
            showToast("Account Created Successfully!");
            updateDashboardUI();
            showScreen('dashboardHub');
        }

        function saveUserData() {
            if (currentUser) {
                localStorage.setItem('vipy_user', JSON.stringify(currentUser));
            }
        }

        function loadUserData() {
            const saved = localStorage.getItem('vipy_user');
            if (saved) {
                currentUser = JSON.parse(saved);
                document.getElementById('loginUserDisplay').innerText = `Welcome back, ${currentUser.fullName.split(' ')[0]}`;
                showScreen('loginScreen');
            } else {
                showScreen('onboardingFlow');
            }
        }

        function switchLoginMode(mode) {
            const tabPin = document.getElementById('loginTabPin');
            const tabFP = document.getElementById('loginTabFP');
            const formPin = document.getElementById('loginPinForm');
            const formFP = document.getElementById('loginFPForm');

            if (mode === 'pin') {
                tabPin.className = "py-2 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm";
                tabFP.className = "py-2 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400";
                formPin.classList.remove('hidden');
                formFP.classList.add('hidden');
            } else {
                tabFP.className = "py-2 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm";
                tabPin.className = "py-2 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400";
                formFP.classList.remove('hidden');
                formPin.classList.add('hidden');
            }
        }

        function attemptPinLogin() {
            const pin = document.getElementById('loginPinInput').value.trim();
            if (!currentUser) return;

            if (pin === currentUser.loginPin) {
                updateDashboardUI();
                showScreen('dashboardHub');
                showToast("Login Successful!");
            } else {
                showToast("Incorrect 6-Digit PIN", true);
            }
        }

        function simulateFingerprintLogin() {
            if (!currentUser) return;
            showToast("Biometric Authenticated!");
            setTimeout(() => {
                updateDashboardUI();
                showScreen('dashboardHub');
            }, 800);
        }

        function logout() {
            showScreen('loginScreen');
            showToast("Logged out successfully");
        }

        function updateDashboardUI() {
            if (!currentUser) return;

            // Update Name
            document.getElementById('dashUserName').innerText = currentUser.fullName;
            const initials = currentUser.fullName.split(' ').map(n => n[0]).join('').substring(0,2).toUpperCase();
            document.getElementById('dashAvatarInitials').innerText = initials || 'VA';

            // Account & Balance
            document.getElementById('dashAccNoDisplay').innerText = currentUser.accountNumber;
            renderBalance();

            // Render Recent History
            renderHistoryLog();
        }

        function renderBalance() {
            const display = document.getElementById('dashBalanceDisplay');
            if (isBalanceHidden) {
                display.innerText = "••••••••";
            } else {
                display.innerText = currentUser.balance.toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
        }

        function toggleBalanceVisibility() {
            isBalanceHidden = !isBalanceHidden;
            const icon = document.getElementById('balanceEyeIcon');
            if (isBalanceHidden) {
                icon.className = "fa-solid fa-eye-slash";
            } else {
                icon.className = "fa-solid fa-eye";
            }
            renderBalance();
        }

        function copyAccNumber() {
            if (!currentUser) return;
            const text = currentUser.accountNumber;
            // Native fallback method
            const tempInput = document.createElement("input");
            tempInput.value = text;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand("copy");
            document.body.removeChild(tempInput);

            showToast("Account number copied to clipboard!");
        }

        function populateBanks() {
            const select = document.getElementById('transferBankSelect');
            select.innerHTML = '<option value="">Select Bank Name</option>';
            NIGERIAN_BANKS.sort().forEach(bank => {
                const opt = document.createElement('option');
                opt.value = bank;
                opt.innerText = bank;
                select.appendChild(opt);
            });
        }

        function simulateAccountLookup() {
            const acc = document.getElementById('transferAccNo').value.trim();
            const lookupBox = document.getElementById('recipientLookupBox');
            const nameDisp = document.getElementById('recipientNameDisplay');

            if (acc.length === 10) {
                lookupBox.classList.remove('hidden');
                nameDisp.innerText = "Verified: " + ["EHEL CHIZOBA ONYECHI", "ONYECHI EMMANUEL B CHINONSO", "RAP ROM", "NWORIE IFEOMA EUCHERIA"][Math.floor(Math.random() * 4)];
            } else {
                lookupBox.classList.add('hidden');
            }
        }

        // Utility Network Selection
        function selectNetwork(net) {
            selectedNetwork = net;
            document.querySelectorAll('.network-btn').forEach(b => {
                b.className = "network-btn border border-slate-200 dark:border-slate-700 p-2 rounded-xl text-center flex flex-col items-center justify-center transition";
            });
            const activeBtn = document.getElementById(`netBtn-${net}`);
            if (activeBtn) {
                activeBtn.className = "network-btn border-2 border-brand-400 bg-brand-400/10 p-2 rounded-xl text-center flex flex-col items-center justify-center transition";
            }
            populateDataPlans();
        }

        function switchUtilityTab(tab) {
            activeUtilityTab = tab;
            const tabAirtime = document.getElementById('tabAirtime');
            const tabData = document.getElementById('tabData');
            const airtimeView = document.getElementById('airtimeView');
            const dataView = document.getElementById('dataView');

            if (tab === 'airtime') {
                tabAirtime.className = "py-2 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm";
                tabData.className = "py-2 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400";
                airtimeView.classList.remove('hidden');
                dataView.classList.add('hidden');
            } else {
                tabData.className = "py-2 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm";
                tabAirtime.className = "py-2 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400";
                dataView.classList.remove('hidden');
                airtimeView.classList.add('hidden');
            }
        }

        function setAirtimeAmount(amt) {
            document.getElementById('airtimeCustomAmount').value = amt;
        }

        function populateDataPlans() {
            const select = document.getElementById('dataPlanSelect');
            select.innerHTML = '';
            const plans = DATA_PLANS[selectedNetwork] || [];
            plans.forEach(plan => {
                const opt = document.createElement('option');
                opt.value = plan.price;
                opt.innerText = plan.label;
                select.appendChild(opt);
            });
        }

        function selectTvProvider(prov) {
            selectedTvProvider = prov;
            const btnGotv = document.getElementById('tvBtnGotv');
            const btnDstv = document.getElementById('tvBtnDstv');

            if (prov === 'GOTV') {
                btnGotv.className = "p-3 border-2 border-brand-400 bg-brand-400/10 rounded-xl font-extrabold text-sm text-brand-600 dark:text-brand-400 flex items-center justify-center space-x-2";
                btnDstv.className = "p-3 border border-slate-200 dark:border-slate-700 rounded-xl font-extrabold text-sm text-blue-500 flex items-center justify-center space-x-2";
            } else {
                btnDstv.className = "p-3 border-2 border-brand-400 bg-brand-400/10 rounded-xl font-extrabold text-sm text-brand-600 dark:text-brand-400 flex items-center justify-center space-x-2";
                btnGotv.className = "p-3 border border-slate-200 dark:border-slate-700 rounded-xl font-extrabold text-sm text-slate-500 flex items-center justify-center space-x-2";
            }
            populateTvPackages();
        }

        function populateTvPackages() {
            const select = document.getElementById('tvPackageSelect');
            select.innerHTML = '';
            const packages = TV_PACKAGES[selectedTvProvider] || [];
            packages.forEach(pkg => {
                const opt = document.createElement('option');
                opt.value = pkg.price;
                opt.innerText = pkg.label;
                select.appendChild(opt);
            });
        }

        function openPinModal(type, target, amount, payload) {
            pendingTx = { type, target, amount, payload };
            document.getElementById('pinModalType').innerText = type;
            document.getElementById('pinModalTarget').innerText = target;
            document.getElementById('pinModalAmount').innerText = "₦" + amount.toLocaleString();
            document.getElementById('txPinAuthInput').value = "";
            document.getElementById('pinAuthModal').classList.remove('hidden');
        }

        function closePinModal() {
            document.getElementById('pinAuthModal').classList.add('hidden');
            pendingTx = null;
        }

        // Initiators
        function initiateTransferModal() {
            const bank = document.getElementById('transferBankSelect').value;
            const acc = document.getElementById('transferAccNo').value.trim();
            const amount = parseFloat(document.getElementById('transferAmount').value);

            if (!bank) return showToast("Select destination bank", true);
            if (acc.length !== 10) return showToast("Enter 10-digit account number", true);
            if (isNaN(amount) || amount <= 0) return showToast("Enter valid amount", true);
            if (amount > currentUser.balance) return showToast("Insufficient Balance", true);

            openPinModal("Bank Transfer", `${bank} - ${acc}`, amount, { bank, acc });
        }

        function initiateAirtimeDataPurchase() {
            const phone = document.getElementById('utilityPhoneNo').value.trim();
            if (phone.length < 11) return showToast("Enter valid 11-digit phone number", true);

            let amount = 0;
            let typeName = "";

            if (activeUtilityTab === 'airtime') {
                amount = parseFloat(document.getElementById('airtimeCustomAmount').value);
                if (isNaN(amount) || amount <= 0) return showToast("Enter valid airtime amount", true);
                typeName = `${selectedNetwork} Airtime Topup`;
            } else {
                amount = parseFloat(document.getElementById('dataPlanSelect').value);
                const planText = document.getElementById('dataPlanSelect').options[document.getElementById('dataPlanSelect').selectedIndex].text;
                typeName = `${selectedNetwork} Data Plan (${planText})`;
            }

            if (amount > currentUser.balance) return showToast("Insufficient Balance", true);

            openPinModal(typeName, phone, amount, { phone });
        }

        function initiateTvCablePurchase() {
            const smartcard = document.getElementById('tvSmartcardNo').value.trim();
            if (smartcard.length < 10) return showToast("Enter valid Decoder/IUC Number", true);

            const amount = parseFloat(document.getElementById('tvPackageSelect').value);
            const pkgText = document.getElementById('tvPackageSelect').options[document.getElementById('tvPackageSelect').selectedIndex].text;

            if (amount > currentUser.balance) return showToast("Insufficient Balance", true);

            openPinModal(`${selectedTvProvider} Subscription`, `${smartcard} (${pkgText})`, amount, { smartcard });
        }

        // Execute Finalized Transaction
        function executePendingTransaction() {
            const pin = document.getElementById('txPinAuthInput').value.trim();
            if (pin !== currentUser.txPin) {
                showToast("Incorrect 4-Digit Transaction PIN", true);
                return;
            }

            // Deduct balance and record history
            currentUser.balance -= pendingTx.amount;
            const newLog = {
                type: pendingTx.type,
                title: pendingTx.type,
                amount: pendingTx.amount,
                isCredit: false,
                date: new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                ref: 'VIPY-TX-' + Math.floor(100000 + Math.random() * 900000)
            };

            currentUser.history.unshift(newLog);
            saveUserData();
            closePinModal();
            updateDashboardUI();
            showToast("Transaction Successful!");
            showScreen('dashboardHub');
        }

        // Deposit Flow
        function openDepositModal() {
            document.getElementById('depositModal').classList.remove('hidden');
        }

        function closeDepositModal() {
            document.getElementById('depositModal').classList.add('hidden');
        }

        function executeDeposit() {
            const amt = parseFloat(document.getElementById('depositAmountInput').value);
            if (isNaN(amt) || amt <= 0) {
                showToast("Enter a valid deposit amount", true);
                return;
            }

            currentUser.balance += amt;
            currentUser.history.unshift({
                type: 'Deposit',
                title: 'Instant Topup',
                amount: amt,
                isCredit: true,
                date: new Date().toLocaleDateString() + ' ' + new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}),
                ref: 'VIPY-DEP-' + Math.floor(100000 + Math.random() * 900000)
            });

            saveUserData();
            closeDepositModal();
            updateDashboardUI();
            showToast(`₦${amt.toLocaleString()} added to balance!`);
        }

        function renderHistoryLog() {
            const recentContainer = document.getElementById('dashRecentTxList');
            const fullContainer = document.getElementById('fullTxHistoryList');

            if (!currentUser || !currentUser.history) return;

            let recentHTML = "";
            let fullHTML = "";

            currentUser.history.forEach((tx, idx) => {
                const iconClass = tx.isCredit ? "fa-arrow-down text-emerald-500 bg-emerald-500/10" : "fa-arrow-up text-red-500 bg-red-500/10";
                const amountSign = tx.isCredit ? "+" : "-";
                const amountColor = tx.isCredit ? "text-emerald-500" : "text-slate-900 dark:text-white";

                const cardHTML = `
                    <div class="flex items-center justify-between p-3 rounded-xl bg-slate-50 dark:bg-slate-800/40 border border-slate-100 dark:border-slate-800/60">
                        <div class="flex items-center space-x-3">
                            <div class="w-9 h-9 rounded-full flex items-center justify-center text-sm ${iconClass}">
                                <i class="fa-solid ${iconClass.split(' ')[0]}"></i>
                            </div>
                            <div>
                                <h5 class="text-xs font-bold text-slate-800 dark:text-slate-200">${tx.title}</h5>
                                <p class="text-[10px] text-slate-400">${tx.date}</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs font-extrabold ${amountColor}">${amountSign}₦${tx.amount.toLocaleString('en-NG', {minimumFractionDigits: 2})}</span>
                            <span class="block text-[9px] text-slate-400">${tx.ref}</span>
                        </div>
                    </div>
                `;

                if (idx < 3) recentHTML += cardHTML;
                fullHTML += cardHTML;
            });

            recentContainer.innerHTML = recentHTML || `<p class="text-xs text-slate-400 text-center py-2">No recent activity</p>`;
            fullContainer.innerHTML = fullHTML || `<p class="text-xs text-slate-400 text-center py-2">No transaction history</p>`;
        }
    </script>
</body>
</html>