<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>V PAY - Beyond Mobile Banking....</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f4fce3',
                            100: '#e6f7c1',
                            200: '#d0f08b',
                            300: '#b2e54d',
                            400: '#8ae600', // Primary VIPY Yellowish-Green
                            500: '#72c000',
                            600: '#589800',
                            700: '#437302',
                            800: '#375b08',
                            900: '#2f4d0c',
                        },
                        darkbg: '#0F172A',
                        darkcard: '#1E293B',
                        darkinput: '#334155'
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <style>
        * {
            -webkit-tap-highlight-color: transparent;
            user-select: none;
        }
        input, select, textarea {
            user-select: text;
        }
        html {
            scroll-behavior: smooth;
            font-family: 'Inter', sans-serif;
        }
        /* Hide scrollbars for slick mobile app look */
        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
        /* Face Scanner Animation */
        @keyframes scan {
            0% { top: 0%; }
            50% { top: 85%; }
            100% { top: 0%; }
        }
        .scan-line {
            animation: scan 2s infinite ease-in-out;
        }
        /* Fingerprint Pulse Animation */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); opacity: 0.8; }
            50% { transform: scale(1.1); opacity: 0.4; }
            100% { transform: scale(0.95); opacity: 0.8; }
        }
        .fp-pulse {
            animation: pulse-ring 2s infinite;
        }
    </style>
</head>
<body class="bg-slate-100 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex justify-center items-center font-sans antialiased selection:bg-brand-400 selection:text-black">

    <!-- Preloader -->
    <div id="preloader" class="fixed inset-0 z-50 bg-slate-900 flex flex-col justify-center items-center transition-opacity duration-500">
        <div class="relative flex items-center justify-center">
            <div class="w-20 h-20 rounded-full border-4 border-brand-400/20 border-t-brand-400 animate-spin"></div>
            <div class="absolute font-extrabold text-2xl tracking-wider text-brand-400">V</div>
        </div>
        <h1 class="mt-6 text-2xl font-black text-white tracking-wider">V PAY<span class="text-brand-400">.</span></h1>
        <p class="text-slate-400 text-xs mt-1 font-medium tracking-widest lowercase">Beyond Banking Solutions.....</p>
    </div>

    <!-- App Container (Mobile View Frame) -->
    <div id="app" class="w-full max-w-md h-screen md:h-[844px] md:rounded-[40px] md:shadow-2xl bg-white dark:bg-slate-900 overflow-hidden flex flex-col relative md:border-[8px] md:border-slate-800">

        <!-- Top Header Controls (Always Accessible) -->
        <header class="bg-white/80 dark:bg-slate-900/80 backdrop-blur-md px-5 py-3 flex items-center justify-between border-b border-slate-100 dark:border-slate-800 z-30 shrink-0">
            <div class="flex items-center space-x-2">
                <div class="w-8 h-8 rounded-xl bg-brand-400 flex items-center justify-center font-black text-slate-950 shadow-md shadow-brand-400/20">V</div>
                <span class="font-extrabold text-xl tracking-tight text-slate-900 dark:text-white">V PAY</span>
            </div>
            
            <div class="flex items-center space-x-3">
                <!-- Dark / Light Mode Toggle Button -->
                <button id="themeToggle" onclick="toggleTheme()" class="w-9 h-9 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 flex items-center justify-center transition-all hover:scale-105 active:scale-95">
                    <i class="fa-solid fa-moon text-sm dark:hidden"></i>
                    <i class="fa-solid fa-sun text-sm hidden dark:block text-amber-400"></i>
                </button>
                <div class="text-[10px] bg-brand-400/20 text-brand-600 dark:text-brand-400 font-bold px-2.5 py-1 rounded-full uppercase tracking-wider">
                    Nigeria
                </div>
            </div>
        </header>

        <!-- Main Screen Body Container -->
        <main class="flex-1 overflow-y-auto no-scrollbar relative p-4" id="mainContent">

            <!-- ================= ONBOARDING / REGISTRATION FLOW ================= -->
            <section id="onboardingFlow" class="space-y-5">

                <!-- Step Progress Bar -->
                <div class="flex items-center justify-between my-2 px-1">
                    <div id="stepDot1" class="h-1.5 flex-1 rounded-full bg-brand-400"></div>
                    <div id="stepDot2" class="h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-slate-800 mx-1"></div>
                    <div id="stepDot3" class="h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-slate-800 mr-1"></div>
                    <div id="stepDot4" class="h-1.5 flex-1 rounded-full bg-slate-200 dark:bg-slate-800"></div>
                </div>

                <!-- STEP 1: PHONE NUMBER VERIFICATION -->
                <div id="obStep1" class="space-y-4">
                    <div class="text-left space-y-1">
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Get Started with V PAY</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Enter your phone number to receive a verification code.</p>
                    </div>

                    <div class="space-y-3 pt-2">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Phone Number</label>
                            <div class="relative">
                                <span class="absolute left-3.5 top-3.5 text-sm font-semibold text-slate-400">+234</span>
                                <input type="tel" id="regPhone" maxlength="10" placeholder="801 234 5678" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3 pl-16 pr-4 text-slate-900 dark:text-white focus:outline-none focus:border-brand-400 text-sm font-medium">
                            </div>
                        </div>

                        <button onclick="triggerPhoneOTP()" class="w-full bg-brand-400 hover:bg-brand-500 text-slate-950 font-bold py-3.5 rounded-xl shadow-lg shadow-brand-400/20 active:scale-[0.98] transition">
                            Send Verification Code
                        </button>

                        <div class="text-center pt-3">
                            <span class="text-xs text-slate-500">Already registered? </span>
                            <button onclick="showScreen('loginScreen')" class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">Log In</button>
                        </div>
                    </div>
                </div>

                <!-- STEP 2: IDENTITY VERIFICATION (NIN / BVN) -->
                <div id="obStep2" class="space-y-4 hidden">
                    <div class="text-left space-y-1">
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Verify Identity</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Choose your preferred identity document for verification.</p>
                    </div>

                    <!-- NIN or BVN Selector Tabs -->
                    <div class="grid grid-cols-2 gap-2 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
                        <button id="idTabNIN" onclick="selectIdType('NIN')" class="py-2.5 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm">
                            11-Digit NIN
                        </button>
                        <button id="idTabBVN" onclick="selectIdType('BVN')" class="py-2.5 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400">
                            11-Digit BVN
                        </button>
                    </div>

                    <div class="space-y-3">
                        <div>
                            <label id="idNumberLabel" class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Enter National Identity Number (NIN)</label>
                            <input type="text" id="idNumberInput" maxlength="11" placeholder="12345678901" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-4 text-slate-900 dark:text-white focus:outline-none focus:border-brand-400 text-sm font-semibold tracking-wider">
                            <p class="text-[10px] text-slate-400 mt-1">Must be exactly 11 numeric digits.</p>
                        </div>

                        <button onclick="verifyIdentity()" class="w-full bg-brand-400 hover:bg-brand-500 text-slate-950 font-bold py-3.5 rounded-xl shadow-lg shadow-brand-400/20 active:scale-[0.98] transition">
                            Verify Identity
                        </button>
                    </div>
                </div>

                <!-- STEP 3: PROFILE & FACE VERIFICATION -->
                <div id="obStep3" class="space-y-4 hidden">
                    <div class="text-left space-y-1">
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Profile & Face Biometrics</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Set up your profile name and complete face verification.</p>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Full Legal Name</label>
                            <input type="text" id="regFullName" placeholder="e.g. Chukwuma Adebayo" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-4 text-slate-900 dark:text-white focus:outline-none focus:border-brand-400 text-sm font-medium">
                        </div>

                        <!-- Face Scanner Container -->
                        <div class="bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-2xl p-4 text-center space-y-3">
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400">Live Facial Verification</label>
                            <div class="relative w-32 h-32 mx-auto rounded-full bg-slate-200 dark:bg-slate-700 border-2 border-dashed border-brand-400 overflow-hidden flex items-center justify-center">
                                <i class="fa-solid fa-user text-4xl text-slate-400"></i>
                                <!-- Scanning Animation Line -->
                                <div id="faceScannerLine" class="absolute left-0 right-0 h-1 bg-brand-400 shadow-lg shadow-brand-400 scan-line hidden"></div>
                                <div id="faceCheckMark" class="absolute inset-0 bg-brand-400/90 flex items-center justify-center text-slate-950 font-bold text-2xl hidden">
                                    <i class="fa-solid fa-check-circle"></i>
                                </div>
                            </div>
                            <button id="startScanBtn" type="button" onclick="simulatedFaceScan()" class="text-xs font-bold text-brand-600 dark:text-brand-400 border border-brand-400/40 px-3 py-1.5 rounded-lg hover:bg-brand-400/10 transition">
                                <i class="fa-solid fa-camera mr-1"></i> Scan Face Now
                            </button>
                        </div>

                        <button onclick="submitProfileAndFace()" class="w-full bg-brand-400 hover:bg-brand-500 text-slate-950 font-bold py-3.5 rounded-xl shadow-lg shadow-brand-400/20 active:scale-[0.98] transition">
                            Continue Security Setup
                        </button>
                    </div>
                </div>

                <!-- STEP 4: SECURITY PIN SETUP -->
                <div id="obStep4" class="space-y-4 hidden">
                    <div class="text-left space-y-1">
                        <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Security Setup</h2>
                        <p class="text-xs text-slate-500 dark:text-slate-400">Create your security credentials to protect your account.</p>
                    </div>

                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Create 6-Digit Login PIN</label>
                            <input type="password" id="createLoginPin" maxlength="6" pattern="\d*" placeholder="••••••" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-4 text-center tracking-[0.5em] text-slate-900 dark:text-white text-lg font-bold focus:outline-none focus:border-brand-400">
                        </div>

                        <div>
                            <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Create 4-Digit Transaction PIN</label>
                            <input type="password" id="createTxPin" maxlength="4" pattern="\d*" placeholder="••••" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-4 text-center tracking-[0.5em] text-slate-900 dark:text-white text-lg font-bold focus:outline-none focus:border-brand-400">
                        </div>

                        <button onclick="finalizeRegistration()" class="w-full bg-brand-400 hover:bg-brand-500 text-slate-950 font-bold py-3.5 rounded-xl shadow-lg shadow-brand-400/20 active:scale-[0.98] transition">
                            Create V PAY Account
                        </button>
                    </div>
                </div>

            </section>

            <!-- ================= LOGIN SCREEN ================= -->
            <section id="loginScreen" class="space-y-6 pt-6 hidden">
                <div class="text-center space-y-2">
                    <div class="w-16 h-16 bg-brand-400/20 text-brand-600 dark:text-brand-400 rounded-2xl mx-auto flex items-center justify-center text-2xl font-black shadow-inner">
                        V
                    </div>
                    <h2 class="text-2xl font-bold text-slate-900 dark:text-white">Welcome Back</h2>
                    <p id="loginUserDisplay" class="text-xs text-slate-500 dark:text-slate-400">Log in to your V PAY Banking App</p>
                </div>

                <!-- Login Method Tabs -->
                <div class="grid grid-cols-2 gap-2 bg-slate-100 dark:bg-slate-800 p-1 rounded-xl">
                    <button id="loginTabPin" onclick="switchLoginMode('pin')" class="py-2 rounded-lg text-xs font-bold transition bg-white dark:bg-slate-700 text-slate-900 dark:text-white shadow-sm">
                        6-Digit PIN
                    </button>
                    <button id="loginTabFP" onclick="switchLoginMode('fp')" class="py-2 rounded-lg text-xs font-bold transition text-slate-500 dark:text-slate-400">
                        Fingerprint
                    </button>
                </div>

                <!-- PIN Login Form -->
                <div id="loginPinForm" class="space-y-4">
                    <div>
                        <input type="password" id="loginPinInput" maxlength="6" pattern="\d*" placeholder="••••••" class="w-full bg-slate-50 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3.5 px-4 text-center tracking-[0.5em] text-slate-900 dark:text-white text-xl font-bold focus:outline-none focus:border-brand-400">
                    </div>
                    <button onclick="attemptPinLogin()" class="w-full bg-brand-400 hover:bg-brand-500 text-slate-950 font-bold py-3.5 rounded-xl shadow-lg shadow-brand-400/20 active:scale-[0.98] transition">
                        Login
                    </button>
                </div>

                <!-- Fingerprint Login Form -->
                <div id="loginFPForm" class="space-y-4 text-center hidden py-4">
                    <div onclick="simulateFingerprintLogin()" class="w-24 h-24 rounded-full bg-brand-400/10 border-2 border-brand-400/30 mx-auto flex items-center justify-center cursor-pointer hover:scale-105 active:scale-95 transition fp-pulse">
                        <i class="fa-solid fa-fingerprint text-5xl text-brand-600 dark:text-brand-400"></i>
                    </div>
                    <p class="text-xs text-slate-500">Tap the sensor above to authorize login with Biometrics</p>
                </div>

                <div class="text-center pt-4">
                    <span class="text-xs text-slate-500">Need an account? </span>
                    <button onclick="showScreen('onboardingFlow')" class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">Register New Account</button>
                </div>
            </section>

            <!-- ================= DASHBOARD / MAIN HUB ================= -->
            <section id="dashboardHub" class="space-y-5 hidden pb-20">

                <!-- User Greeting & Profile Summary Header -->
                <div class="flex items-center justify-between">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-full bg-gradient-to-tr from-brand-500 to-brand-300 text-slate-950 font-bold flex items-center justify-center text-sm shadow">
                            <span id="dashAvatarInitials">VA</span>
                        </div>
                        <div>
                            <p class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Welcome back,</p>
                            <h3 id="dashUserName" class="text-base font-bold text-slate-900 dark:text-white">Valued Customer</h3>
                        </div>
                    </div>
                    <button onclick="logout()" class="text-xs text-slate-400 hover:text-red-500 transition">
                        <i class="fa-solid fa-right-from-bracket text-base"></i>
                    </button>
                </div>

                <!-- Main Balance & Account Card -->
                <div class="bg-gradient-to-br from-slate-900 via-slate-800 to-slate-950 text-white rounded-2xl p-5 shadow-xl relative overflow-hidden border border-slate-700/50">
                    <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-brand-400/10 rounded-full blur-2xl pointer-events-none"></div>

                    <div class="flex items-center justify-between text-slate-400 text-xs font-medium mb-1">
                        <span>V PAY Account Balance</span>
                        <button onclick="toggleBalanceVisibility()" class="text-slate-300 hover:text-white transition">
                            <i id="balanceEyeIcon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>

                    <div class="flex items-baseline space-x-1 my-1">
                        <span class="text-lg font-bold text-brand-400">$</span>
                        <h2 id="dashBalanceDisplay" class="text-3xl font-extrabold tracking-tight">5,000,000,.00</h2>
                    </div>

                    <div class="mt-4 pt-3 border-t border-slate-700/60 flex items-center justify-between text-xs">
                        <div>
                            <span class="text-slate-400 block text-[10px] uppercase">Account Number</span>
                            <div class="flex items-center space-x-2">
                                <span id="dashAccNoDisplay" class="font-mono font-bold tracking-wider text-slate-200">0123456789</span>
                                <button onclick="copyAccNumber()" class="text-brand-400 hover:text-brand-300">
                                    <i class="fa-regular fa-copy text-xs"></i>
                                </button>
                            </div>
                        </div>
                        <button onclick="openDepositModal()" class="bg-brand-400 hover:bg-brand-500 text-slate-950 font-bold px-3 py-1.5 rounded-lg text-xs shadow transition active:scale-95">
                            + Add Money
                        </button>
                    </div>
                </div>

                <!-- Quick Action Buttons Grid -->
                <div class="space-y-2">
                    <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider px-1">Quick Services</h4>
                    <div class="grid grid-cols-4 gap-3">
                        <button onclick="showScreen('transferScreen')" class="flex flex-col items-center p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-brand-400/10 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800 transition active:scale-95">
                            <div class="w-10 h-10 rounded-xl bg-brand-400/20 text-brand-600 dark:text-brand-400 flex items-center justify-center text-lg mb-1.5">
                                <i class="fa-solid fa-paper-plane"></i>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Transfer</span>
                        </button>

                        <button onclick="showScreen('airtimeDataScreen')" class="flex flex-col items-center p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-brand-400/10 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800 transition active:scale-95">
                            <div class="w-10 h-10 rounded-xl bg-blue-500/20 text-blue-500 flex items-center justify-center text-lg mb-1.5">
                                <i class="fa-solid fa-mobile-screen-button"></i>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">Airtime/Data</span>
                        </button>

                        <button onclick="showScreen('tvCableScreen')" class="flex flex-col items-center p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-brand-400/10 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800 transition active:scale-95">
                            <div class="w-10 h-10 rounded-xl bg-purple-500/20 text-purple-500 flex items-center justify-center text-lg mb-1.5">
                                <i class="fa-solid fa-tv"></i>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">TV Cable</span>
                        </button>

                        <button onclick="showScreen('txHistoryScreen')" class="flex flex-col items-center p-3 rounded-xl bg-slate-50 dark:bg-slate-800/60 hover:bg-brand-400/10 dark:hover:bg-slate-800 border border-slate-100 dark:border-slate-800 transition active:scale-95">
                            <div class="w-10 h-10 rounded-xl bg-amber-500/20 text-amber-500 flex items-center justify-center text-lg mb-1.5">
                                <i class="fa-solid fa-receipt"></i>
                            </div>
                            <span class="text-[11px] font-semibold text-slate-700 dark:text-slate-300">History</span>
                        </button>
                    </div>
                </div>

                <!-- Recent Activity Overview -->
                <div class="space-y-2">
                    <div class="flex items-center justify-between px-1">
                        <h4 class="text-xs font-bold text-slate-500 uppercase tracking-wider">Recent Transactions</h4>
                        <button onclick="showScreen('txHistoryScreen')" class="text-xs font-bold text-brand-600 dark:text-brand-400 hover:underline">View All</button>
                    </div>
                    <div id="dashRecentTxList" class="space-y-2">
                        <!-- Dynamic content filled via JS -->
                    </div>
                </div>

            </section>

            <!-- ================= TRANSFER MONEY SCREEN ================= -->
            <section id="transferScreen" class="space-y-4 hidden pb-16">
                <div class="flex items-center space-x-3">
                    <button onclick="showScreen('dashboardHub')" class="w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 flex items-center justify-center text-slate-600 dark:text-slate-300">
                        <i class="fa-solid fa-arrow-left text-xs"></i>
                    </button>
                    <h2 class="text-lg font-bold text-slate-900 dark:text-white">Bank Transfer</h2>
                </div>

                <div class="space-y-3 bg-slate-50 dark:bg-slate-800/50 p-4 rounded-2xl border border-slate-100 dark:border-slate-800">
                    <!-- Bank Selection Dropdown -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Select Destination Bank</label>
                        <select id="transferBankSelect" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-3 text-slate-900 dark:text-white text-xs font-medium focus:outline-none focus:border-brand-400">
                            <!-- Populated dynamically via JS -->
                        </select>
                    </div>

                    <!-- Account Number Field -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Account Number</label>
                        <input type="text" id="transferAccNo" maxlength="10" placeholder="10 Digit Account Number" oninput="simulateAccountLookup()" class="w-full bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl py-3 px-3 text-slate-900 dark:text-white text-xs font-medium focus:outline-none focus:border-brand-400">
                        <!-- Recipient Name Preview -->
                        <div id="recipientLookupBox" class="mt-2 text-xs text-brand-600 dark:text-brand-400 font-bold hidden flex items-center space-x-1">
                            <i class="fa-solid fa-circle-check"></i>
                            <span id="recipientNameDisplay">Name verified</span>
                        </div>
                    </div>

                    <!-- Amount Field -->
                    <div>
                        <label class="block text-xs font-semibold text-slate-600 dark:text-slate-400 mb-1">Amount ($)</label>
