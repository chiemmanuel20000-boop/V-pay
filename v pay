                { id: "a1", label: "Airtel 750MB 1-Day - ₦300", price: 300 },
                { id: "a2", label: "Airtel 1.5GB 2-Days - ₦500", price: 500 },
                { id: "a3", label: "Airtel 12GB Monthly - ₦3,500", price: 3500 }
